# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Build / install artefacts
build/
dist/
*.egg

# Generated outputs from solver runs
outputs/
outputs_*/

# Competition input data (kept out of public/shared repos by default).
# Keep the synthetic sample workbook tracked so anyone cloning can run
# tests/synthetic_box.py without external dependencies.
data/*.xlsx
!data/sample_box.xlsx
!data/official.xlsx

# IDE / editor cruft
.idea/
.vscode/
*.swp
.DS_Store

# Streamlit local secrets
.streamlit/secrets.toml
